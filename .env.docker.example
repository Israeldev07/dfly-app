# Variables para `docker compose` (copiar a .env.docker, que git ignora).
# La imagen corre en modo producción: sin SMTP, WhatsApp o Supabase, el registro, los pedidos
# o la subida de fotos fallan en vez de escribir en la consola como en `npm run dev`.

# ── Base de datos del compose (servicio "db") ──
POSTGRES_PASSWORD="cambia-esta-clave"
# Misma clave que arriba; el host "db" es el contenedor de Postgres.
DATABASE_URL="postgresql://dfly:cambia-esta-clave@db:5432/dfly"
DIRECT_URL="postgresql://dfly:cambia-esta-clave@db:5432/dfly"

# ── Auth.js ──
# Generar con: npx auth secret
AUTH_SECRET=""
# Fuera de Vercel, Auth.js necesita confiar en el host de la petición (o fijar AUTH_URL).
AUTH_TRUST_HOST="true"
# URL pública (enlaces de los correos). En local, http://localhost:3000; en un servidor, su dominio https.
APP_URL="http://localhost:3000"
# Sin proxy delante: "none" (los límites por IP no se aplican). Detrás de nginx/Caddy: "xff:1"; Cloudflare: "cloudflare".
TRUSTED_PROXY="none"
# ── Correo (SMTP) ──
# Código de verificación y enlace de recuperación de contraseña.
# Sin SMTP_HOST, en desarrollo los correos salen en la consola del servidor ([email:dev]).
# Puerto 587 = STARTTLS; 465 = TLS directo (o SMTP_SECURE="true").
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Dfly <no-responder@tu-dominio.com>"

# ── WhatsApp Cloud API (Meta) ──
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
# Número (E.164) del dueño de Dfly que recibe cada pedido completo.
ADMIN_WHATSAPP_TO="+593990000000"
# El código para verificar el celular sale con la plantilla de autenticación `codigo_verificacion`
# (categoría AUTHENTICATION, botón "Copiar código"), que debe estar aprobada en Meta.

# ── Seguridad de pedidos y crons ──
# Firma HMAC de los botones Aceptar/Rechazar.
ORDER_ACTION_SECRET=""
CRON_SECRET=""
ORDER_RESPONSE_TIMEOUT_MIN="5"

# Solo para el seed (opcional)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Si ya existe una cuenta con ese email y no es ADMIN, el seed se detiene.
# Ponlo en "true" solo si esa cuenta es tuya: la asciende y reemplaza su contraseña.
SEED_ADMIN_PROMOTE_EXISTING=""
# "true" crea además los 5 comercios de ejemplo (WhatsApp ficticios). Solo en desarrollo.
SEED_DEMO_STORES=""

# Costo de envío fijo en centavos de USD ($2.00)
DELIVERY_FEE_CENTS="200"
# Versión de la Graph API de Meta
WHATSAPP_API_VERSION="v25.0"

# ── Fotos de comercios y productos (Supabase Storage) ──
# Sin estas variables, en desarrollo las fotos se guardan en public/uploads.
# El bucket debe ser público (lectura); la subida usa la service role key, solo en el servidor.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="dfly"
